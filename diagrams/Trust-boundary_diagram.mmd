flowchart LR
    %% Numbers identify relations; dashed attacker arrows are not normal processing steps.
    subgraph Server["Trusted Dicoogle server - proposed key custody"]
        Identity["CURRENT: Session/token validation"]
        Policy["PROPOSED: Study permission and current-version policy"]
        KeyStore["PROPOSED: Durable protected DEK registry<br/>Server KEK protects stored DEKs"]
        Retrieval["Metadata, native frames and key-access responses"]
        Identity -->|"1a. Authenticated principal"| Policy
        Policy -->|"1b. Allow or deny study/key operation"| Retrieval
        KeyStore -->|"1c. Scoped DEK; server is trusted with key material"| Retrieval
    end
    TLS["HTTPS / TLS boundary<br/>Frames, descriptors AND key responses"]
    subgraph Origin["Viewer origin and browser profile/storage partition"]
        subgraph Persistent["Persistent storage"]
            Cache["OPFS: shared ciphertext and protected index"]
            Other["HTTP cache, thumbnails, downloads and logs<br/>Prevent intended plaintext persistence; audit"]
        end
        subgraph Active["Active browser processing - not hard isolation"]
            Gate["Current-user access gate"]
            DEK["Volatile DEK and crypto operations"]
            Check["Expected-context validation and AEAD tag verification"]
            RAM["Bounded plaintext native-frame RAM"]
            Worker["Worker/WASM decode buffers"]
            Cornerstone["Decoded Cornerstone objects"]
            GPU["Canvas, GPU textures and driver state"]
            Gate -->|"4a. Current-session permission to request/use key"| DEK
            DEK -->|"4b. Active cryptographic capability"| Check
            Check -->|"5b. Authenticated plaintext; no decode on failure"| RAM
            RAM -->|"6a. Decode input"| Worker
            Worker -->|"6b. Decoded pixels"| Cornerstone
            Cornerstone -->|"6c. Rendering upload"| GPU
        end
        Cache -->|"5a. Encrypted frame plus untrusted header"| Check
        Check -->|"7. Encrypt native bytes with expected-context AAD"| Cache
    end
    Retrieval -->|"2. Authorised frame, descriptor or DEK response"| TLS
    TLS -->|"3a. DEK/descriptor in browser memory"| DEK
    TLS -->|"3b. Native frame bytes in browser memory"| RAM
    Disk["Offline profile/disk reader"]
    Script["Same-origin XSS or malicious dependency"]
    Cross["Malicious different-origin page"]
    Host["Compromised OS/browser; RAM dump, swap or hibernation"]
    Disk -.->|"8. May recover ciphertext, length and some metadata"| Cache
    Script -.->|"9a. May invoke active key; non-extractability is insufficient"| DEK
    Script -.->|"9b. May read active plaintext"| RAM
    Cross -.->|"10a. XS-Leaks or SVG pixel stealing if embedding is permitted"| GPU
    Cross -.->|"10b. SSD contention via attacker's own OPFS; not direct file access"| Cache
    Host -.->|"11a. May recover keys/plaintext; outside application guarantee"| DEK
    Host -.->|"11b. Residual memory exposure"| Worker
    Host -.->|"11c. Residual rendering exposure"| GPU
